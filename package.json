{
  "name": "tool-atlas",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.7.1-beta.1",
  "packageManager": "pnpm@10.30.2",
  "type": "module",
  "scripts": {
    "catalog:add": "node scripts/add-catalog-tool.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check",
    "dev": "npm run build && node scripts/server.mjs",
    "dev:client": "npm run catalog:build && vite",
    "test": "npm run catalog:check && vitest run",
    "build": "npm run catalog:build && tsc -b && vite build",
    "verify": "npm run test && npm run build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "serve": "npm run start",
    "start": "npm run build && node scripts/server.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
