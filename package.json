{
  "name": "tool-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "catalog:add": "node scripts/add-catalog-tool.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check",
    "dev": "pnpm catalog:build && vite",
    "test": "pnpm catalog:check && vitest run",
    "build": "pnpm catalog:build && tsc -b && vite build",
    "verify": "pnpm test && pnpm build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "serve": "node scripts/server.mjs",
    "start": "node scripts/server.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
