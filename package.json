{
  "name": "tool-atlas",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.7.2",
  "packageManager": "pnpm@10.30.2",
  "type": "module",
  "scripts": {
    "catalog:add": "node scripts/add-catalog-tool.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check",
    "dev": "npm run build && node scripts/server.mjs",
    "dev:client": "npm run catalog:build && vite",
    "test": "npm run catalog:check && vitest run",
    "build": "npm run catalog:build && tsc -b && vite build",
    "verify": "npm run locks:check && npm run lint && npm run docs:check && npm run typecheck && npm run test && npm run build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "serve": "npm run start",
    "start": "npm run build && node scripts/server.mjs",
    "catalog:migrate": "node scripts/migrate-release-order.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src scripts e2e *.ts *.mjs docs README.md CONTRIBUTING.md",
    "format:check": "prettier --check src scripts e2e *.ts *.mjs docs README.md CONTRIBUTING.md",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "test:e2e": "npm run build && playwright test",
    "doctor": "node scripts/doctor.mjs",
    "dev:studio": "npm run build && concurrently --kill-others \"node scripts/dev-studio-server.mjs\" \"vite --host 127.0.0.1\"",
    "docs:check": "node scripts/check-documentation-links.mjs",
    "locks:check": "node scripts/lockfile-policy.mjs",
    "provenance": "node scripts/verification-provenance.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
