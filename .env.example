# Optional public DNS hostname. Empty uses HTTP on port 80 without ACME.
# For HTTPS, set a hostname such as atlas.example.com (no scheme/path/port).
SITE_DOMAIN=

# Exact internal SharePoint/document hosts permitted for Developer Studio guide-link checks.
TOOL_ATLAS_GUIDE_HOSTS=sharepoint.company.local,docs.company.local

# Optional contact address for ACME when using a public domain.
ACME_EMAIL=

# Host ports. Keep 80 and 443 in production for public ACME HTTP validation.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: use a reviewed GHCR image instead of a local Docker build.
# Prefer an immutable digest for production promotion.
# TOOL_ATLAS_IMAGE=ghcr.io/shalevz923/shalevsoftwaresite:1.7.0

# Public About-page version, embedded at build time. Rebuild after changing it.
VITE_APP_VERSION=1.7.0

# Optional local Studio container (compose.studio.yaml), published on localhost only.
STUDIO_PORT=8081
# Linux bind mounts: set these to the owner of the checkout (id -u / id -g).
STUDIO_UID=1000
STUDIO_GID=1000
