# Public DNS hostname only: no scheme, path, or port.
SITE_DOMAIN=atlas.example.com

# Contact address registered with the ACME certificate authority.
ACME_EMAIL=ops@example.com

# Host ports. Keep 80 and 443 in production for public ACME HTTP validation.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: use a reviewed GHCR image instead of a local Docker build.
# Prefer an immutable digest for production promotion.
# TOOL_ATLAS_IMAGE=ghcr.io/shalevz923/shalevsoftwaresite:1.4.0-beta.1
