# ==============================================================================
# 1. Domain, Ports & Corporate CA / TLS (deploy/docker/compose.yaml)
# ==============================================================================

# Optional public or internal DNS hostname. Empty uses HTTP on port 80 without ACME.
# For HTTPS, set a hostname such as atlas.company.local (no scheme/path/port).
SITE_DOMAIN=

# Optional contact address for ACME when using a public or internal ACME CA.
ACME_EMAIL=

# Host ports. Keep 80 and 443 in production.
HTTP_PORT=80
HTTPS_PORT=443

# Host directory mounted read-only into Caddy at /etc/caddy/certs for corporate CA
# certificates, private keys, or internal root CA bundles. Defaults to deploy/docker/.
# TLS_CERT_DIR=/etc/tool-atlas/certs

# Corporate CA Mode A — Static certificate & private key signed by your corporate CA:
# Place fullchain.pem and privkey.pem in TLS_CERT_DIR and uncomment:
# CADDY_TLS_DIRECTIVE=tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
CADDY_TLS_DIRECTIVE=

# Corporate CA Mode B — Internal ACME CA server (Step-CA, Vault PKI, EJBCA, etc.):
# Point Caddy to your internal ACME directory URL (and optional corporate root CA
# in TLS_CERT_DIR) so certificates renew automatically:
# CADDY_ACME_CA_DIRECTIVE=acme_ca https://ca.company.local/acme/acme/directory
CADDY_ACME_CA_DIRECTIVE=

# ==============================================================================
# 2. Storage & Volume Mounts (Packages & Guide Library)
# ==============================================================================

# Host path to the same-server installer storage directory (/downloads/<tool>/<ver>/<file>).
# Relative paths in Docker Compose resolve from deploy/docker/ (default: ../../packages).
# Set an absolute path (e.g., /mnt/nas/tool-atlas/packages) to mount external storage.
# PACKAGES_DIR=../../packages

# Host path to the approved PDF/PPTX guide library directory (/guides/<tool>/<file>).
# Relative paths in Docker Compose resolve from deploy/docker/ (default: ../../guide-library).
# GUIDE_LIBRARY_DIR=../../guide-library

# Optional UID/GID for the one-shot publisher container in compose.hosted-downloads.yaml.
# HOSTED_DOWNLOAD_UID=1000
# HOSTED_DOWNLOAD_GID=1000

# ==============================================================================
# 3. UI Pages, Version & Branding (Build-Time Vite Variables)
# ==============================================================================
# Note: VITE_* variables are embedded into the static frontend at build time.
# Rebuild the app or Docker image after changing these values.

# Public About-page version label. Defaults to package.json version when blank.
VITE_APP_VERSION=1.7.2

# Comma-separated list of pages to hide from the sidebar navigation and router.
# Supported values: documentation, updates, about, developer
# ("catalog" is always visible as the primary landing page).
# Example: VITE_HIDDEN_PAGES=updates,about
VITE_HIDDEN_PAGES=

# Support contact email linked on the About page ("Talk to the team").
VITE_SUPPORT_EMAIL=devex@atlas.local

# Tool Atlas MCP server endpoint displayed in the About page IDE snippet.
VITE_MCP_URL=https://mcp.atlas.example.com/mcp

# ==============================================================================
# 4. Container Image Promotion
# ==============================================================================

# Optional: use a reviewed GHCR or internal registry image instead of a local Docker build.
# Prefer an immutable digest for production promotion.
# TOOL_ATLAS_IMAGE=ghcr.io/shalevz923/shalevsoftwaresite:1.7.2

# ==============================================================================
# 5. Local Developer Studio & Intranet Guide Checks (compose.studio.yaml)
# ==============================================================================

# Localhost port for the optional Developer Studio authoring container (127.0.0.1 only).
STUDIO_PORT=8081

# Linux bind mounts: set these to the numeric owner of the checkout (id -u / id -g).
STUDIO_UID=1000
STUDIO_GID=1000

# Exact internal SharePoint/document hosts permitted for Developer Studio guide-link checks.
TOOL_ATLAS_GUIDE_HOSTS=sharepoint.company.local,docs.company.local

# Direct Node server settings (scripts/server.mjs when run outside Docker):
# HOST=127.0.0.1
# PORT=8080
# Set to "true" only when terminating TLS at a trusted reverse proxy in front of scripts/server.mjs:
# TOOL_ATLAS_BEHIND_TLS_PROXY=false
