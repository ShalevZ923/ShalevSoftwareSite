{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Atlas agent catalog listing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "icon",
    "description",
    "highlights",
    "updatedAt",
    "status",
    "review",
    "capabilities",
    "compatibility",
    "requirements",
    "riskLevel",
    "permissions",
    "contents",
    "maintainer",
    "tags"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 100
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 8
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 180
    },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 36, "pattern": "\\S" }
    },
    "downloadButtonLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 44,
      "pattern": "\\S"
    },
    "updatedAt": {
      "type": "string",
      "format": "catalog-date"
    },
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "evaluation",
        "deprecated",
        "example"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "date": {
          "type": "string",
          "format": "catalog-date"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "currentVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "status",
          "notes"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "verifiedOn": {
            "type": "string",
            "format": "catalog-date"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "catalog-https"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Unknown"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "contents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "enum": [
              "skill",
              "script",
              "prompt",
              "config",
              "doc",
              "asset"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "team",
        "initials",
        "email"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "team": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "initials": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "hosting",
        "authentication",
        "tools",
        "resources",
        "prompts"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "enum": [
            "stdio",
            "streamable-http",
            "sse",
            "custom",
            "unknown"
          ]
        },
        "hosting": {
          "type": "string",
          "enum": [
            "local",
            "remote",
            "unknown"
          ]
        },
        "authentication": {
          "type": "string",
          "enum": [
            "none",
            "oauth",
            "token",
            "unknown"
          ]
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "effect"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_./-]+$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "effect": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "execute",
                  "unknown"
                ]
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["unpack"] },
        { "required": ["mcp"] }
      ],
      "properties": {
        "unpack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "global"
          ],
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "global": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "config"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "config": {
              "type": "object"
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "title",
        "message"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "info",
            "warning"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
