{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Atlas catalog release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "releasedAt"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "releasedAt": {
      "type": "string",
      "format": "catalog-date"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "archiveRoot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "kind": { "type": "string", "enum": ["skill", "script", "prompt", "config", "doc", "asset"] },
          "note": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "evidence"],
      "properties": {
        "date": { "type": "string", "format": "catalog-date" },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
