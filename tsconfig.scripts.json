{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/submission-fields.mjs",
    "scripts/api-errors.mjs",
    "scripts/mutation-coordinator.mjs",
    "scripts/catalog-persistence.mjs",
    "scripts/documentation-files.mjs"
  ]
}
